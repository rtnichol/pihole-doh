# Copy this file to .env and fill in your values
# cp .env.example .env

# Pi-hole web interface password
PIHOLE_PASSWORD=changeme

# Web UI port on the host (default 8080 to avoid conflict with other services)
PIHOLE_WEB_PORT=8080

# Your local timezone (used by Pi-hole for query logs)
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York
